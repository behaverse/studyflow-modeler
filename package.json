{
  "name": "studyflow-modeler",
  "private": true,
  "version": "26.9.18",
  "license": "MIT",
  "workspaces": [
    "packages/*",
    "skills/browser"
  ],
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "npm run dev -w @behaverse/studyflow-modeler --",
    "dev:desktop": "npm run dev -- --mode desktop",
    "build": "rm -rf dist && npm run build --workspaces --if-present --",
    "typecheck": "tsc --noEmit && npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "test": "playwright test",
    "test:unit": "playwright test --config playwright.unit.config.ts",
    "test:e2e": "playwright test --project=e2e",
    "examples:render": "node packages/cli/scripts/render-examples.mjs",
    "docs": "quarto preview docs --no-browser",
    "docs:build": "quarto render docs",
    "release": "node packages/cli/scripts/release.mjs"
  },
  "devDependencies": {
    "@behaverse/studyflow-browser-skill": "*",
    "@behaverse/studyflow-core": "*",
    "@behaverse/studyflow-modeler": "*",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/js-yaml": "^4.0.9",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^25.9.6",
    "@typescript-eslint/parser": "^8.65.0",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "jsdom": "^30.0.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "fsevents@2.3.2": true,
    "fsevents@2.3.3": true
  }
}
