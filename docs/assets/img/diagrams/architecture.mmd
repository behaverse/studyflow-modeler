%% Regenerate: npx -y @mermaid-js/mermaid-cli -i architecture.mmd -o architecture.svg -c mermaid.config.json -b transparent
%% The config keeps labels as plain SVG text (no foreignObject), so the .svg survives being embedded as an image.
flowchart TB

  MODELER["`**modeler**
  packages/modeler
  authoring UI`"]
  BROWSER["`**runner**
  packages/runner
  served at ./run/`"]
  HANDOFF[("localStorage<br/>studyflow-modeler:handoff:ID<br/>swept after an hour")]
  CORE["`**core**
  packages/core
  YAML ⇄ BPMN · element access`"]
  SCHEMAS[/"assets/schemas/*.moddle.yaml<br/>studyflow · prov · cognitive · eeg<br/>functional · ml · agentic"/]
  CLI["`**cli**
  packages/cli
  convert · validate · info · run`"]
  PY["`**runner-py**
  packages/runner-py
  studyflow_run.py`"]
  IMPL["python modules<br/>sklearn, pandas, your own code"]
  API["api.behaverse.org<br/>publishing"]
  DATA["data.behaverse.org<br/>event recording"]

  MODELER -->|"imports"| CORE
  BROWSER -->|"imports"| CORE
  CLI -->|"wraps"| CORE
  CORE -->|"parses all of, at boot"| SCHEMAS

  MODELER -->|"writes the diagram XML into"| HANDOFF
  MODELER ==>|"opens ./run/?diagram=ID&seed=N"| BROWSER
  BROWSER -->|"reads back, then clears"| HANDOFF
  MODELER -->|"POSTs XML to<br/>/v1/studies/NAME/flow"| API
  BROWSER -->|"records sessions<br/>and events, opt-in"| DATA

  CLI ==>|"spawns for runtime = local"| PY
  PY -->|"imports what<br/>python:// names"| IMPL

  classDef pkg fill:#eef2ff,stroke:#4f46e5,stroke-width:1.5px,color:#1e1b4b
  classDef ext fill:#f5f5f4,stroke:#78716c,stroke-width:1.5px,color:#1c1917
  classDef res fill:#fefce8,stroke:#a16207,stroke-width:1.5px,color:#422006
  class MODELER,BROWSER,CORE,CLI,PY pkg
  class API,DATA,IMPL ext
  class SCHEMAS,HANDOFF res
