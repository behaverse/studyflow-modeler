%% Regenerate: npx -y @mermaid-js/mermaid-cli -i gap.mmd -o gap.svg -c mermaid.config.json -b transparent
%% The config keeps labels as plain SVG text (no foreignObject), so the .svg survives being embedded as an image.
%% Placeholder: to be replaced by a drawn figure of the same two halves.
flowchart TB

  subgraph COPIES["a study, written five times"]
    direction LR
    PROTO["protocol"]
    PREREG["preregistration"]
    SCRIPT["session script"]
    NB["analysis notebook"]
    FIG["methods figure"]
    PROTO x-.-x PREREG
    PREREG x-.-x SCRIPT
    SCRIPT x-.-x NB
    NB x-.-x FIG
  end

  subgraph ONE["a study, written once"]
    direction LR
    DOC["the studyflow file"]
    V1["protocol"]
    V2["runnable session"]
    V3["analysis specification"]
    V4["methods figure"]
    DOC ==> V1
    DOC ==> V2
    DOC ==> V3
    DOC ==> V4
  end

  COPIES ~~~ ONE

  classDef copy fill:#f5f5f4,stroke:#78716c,stroke-width:1.5px,color:#1c1917
  classDef doc fill:#eef2ff,stroke:#4f46e5,stroke-width:1.5px,color:#1e1b4b
  classDef view fill:#fefce8,stroke:#a16207,stroke-width:1.5px,color:#422006
  class PROTO,PREREG,SCRIPT,NB,FIG copy
  class DOC doc
  class V1,V2,V3,V4 view
