id: behaverse_demo
definitions:
  targetNamespace: http://bpmn.io/schema/bpmn
Behaverse_Demo:
  type: bpmn:Process
  name: Behaverse task
  documentation: A single Behaverse assessment, run on its own. The task and its timeline are parameters of the study (config, wired nowhere, so every step reads it), so one diagram delivers any task the build ships. It carries no start or end event on purpose - nothing but the task itself is shown.
  extensionElements:
    - type: studyflow:Study
  properties:
    P_Task:
      name: task
    P_Timeline:
      name: timeline
  flowElements:
    Config:
      type: bpmn:DataObjectReference
      name: config
      extensionElements:
        - type: studyflow:Parameters
          values: |
            task: BCS
            timeline: XCIT_BCS_02
    GameConfig:
      type: bpmn:DataObjectReference
      name: GameConfig
      extensionElements:
        - type: studyflow:Parameters
          values: |
            Timelines:
              "{timeline}":
    Task:
      type: bpmn:Task
      name: "{task} / {timeline}"
      dataInputAssociations:
        In_GameConfig:
          sourceRef:
            - GameConfig
      extensionElements:
        - type: behaverse:Task
          scene: "{task}"
