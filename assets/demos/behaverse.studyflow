id: behaverse_demo
definitions:
  targetNamespace: http://bpmn.io/schema/bpmn
Behaverse_Demo:
  type: bpmn:Process
  name: Behaverse task
  documentation: A single Behaverse assessment, run on its own. Its scene and timeline are the Parameters wired into it, which a link replaces (`?scene=NB&timeline=XCIT_NB_01`), so one diagram delivers any task the build ships. It carries no start or end event on purpose - nothing but the task itself is shown.
  extensionElements:
    - type: studyflow:Study
  flowElements:
    Task_Parameters:
      type: bpmn:DataObjectReference
      name: task
      extensionElements:
        - type: studyflow:Parameters
          values: |
            scene: BCS
            timeline: XCIT_BCS_02
    Task:
      type: bpmn:Task
      name: Behaverse task
      dataInputAssociations:
        In_Task_Parameters:
          sourceRef:
            - Task_Parameters
      extensionElements:
        - type: behaverse:Task
