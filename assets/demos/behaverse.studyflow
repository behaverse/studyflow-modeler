id: behaverse_demo
definitions:
  targetNamespace: http://bpmn.io/schema/bpmn
Behaverse_Demo:
  type: bpmn:Process
  name: Behaverse task
  documentation: A single Behaverse assessment, run on its own. Its instrument is the study's `task` property, its timeline the Parameters wired into it, and a link replaces either (`?task=NB&timeline=XCIT_NB_01`), so one diagram delivers any task the build ships. It carries no start or end event on purpose - nothing but the task itself is shown.
  extensionElements:
    - type: studyflow:Study
  properties:
    P_Task:
      name: task
      value: BCS
  flowElements:
    Task_Parameters:
      type: bpmn:DataObjectReference
      name: timeline
      extensionElements:
        - type: studyflow:Parameters
          values: |
            timeline: XCIT_BCS_02
    Task:
      type: bpmn:Task
      name: Behaverse task
      dataInputAssociations:
        In_Task_Parameters:
          sourceRef:
            - Task_Parameters
      extensionElements:
        - type: behaverse:Task
          instrument: "{task}"
