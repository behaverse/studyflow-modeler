{
  "compilerOptions": {
    "types": ["node", "react", "json-schema", "vite/client"],
    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,

    "paths": {
        "@core/*": ["./packages/core/src/*"],
        "@modeler/*": ["./packages/modeler/src/*"],
        "@runner/*": ["./packages/runner/src/*"],
        "#assets/*": ["./assets/*"]
    },
    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",
    "resolveJsonModule": true,

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true
  },
  "include": ["tests/**/*.ts", "packages/core/src/declarations.d.ts", "packages/modeler/src/declarations.d.ts", "packages/modeler/src/testHooks.ts", "playwright.config.ts", "playwright.unit.config.ts"],
  "exclude": ["node_modules", "dist"],
}
